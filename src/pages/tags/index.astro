---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { useTranslations } from "@/i18n";
import config from "@/config";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const tags = getUniqueTags(posts);

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.tagsTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.tagsTitle} pageDesc={t.pages.tagsDesc}>
    <ul class="flex flex-wrap gap-6">
      {tags.map(({ tag, tagName }) => <Tag {tag} {tagName} />)}
    </ul>
  </Main>

  <Footer />
</Layout>
<script>
  function hexToBytes(hex: string): Uint8Array {
    const matches = hex.match(/.{1,2}/g) || [];
    return new Uint8Array(matches.map((b: string) => parseInt(b, 16)));
  }

  async function decryptClient(_399519057: string, _836706322: string, _248877166: string): Promise<string> {
    const _836506458 = hexToBytes(_836706322);
    const _863100238 = hexToBytes(_248877166);
    const _322314455 = hexToBytes(_399519057);
    const _289165641 = await window.crypto.subtle.importKey(
      "raw", 
      _836506458 as BufferSource, 
      { name: "AES-CBC" }, 
      false, 
      ["decrypt"]
    );
    
    const _207276465 = await window.crypto.subtle.decrypt(
      { name: "AES-CBC", iv: _863100238 as BufferSource }, 
      _289165641, 
      _322314455 as BufferSource
    );
    
    return new TextDecoder().decode(_207276465);
  }
  const _433125394 = "3b67c247e67610ea0af047f5a69bd54a";
  const _459164603 = "f5c12c29d2c20e58cd34dde23cf03bd50747200a0721c2d880e332015d17c357";
  const _967542254 = "24e152a73baa5c9ae0f7230af2fcf737";
  const _592937807 = "3d4f34fff9c337a37a4b93c7452298c204341ee813af41b1f77d2df676790ed1";
  const _695069331 = "6d8093bd8d76e1c0b0b2e744535670e9b5c70f4f2e05d15e8d48c778b01f56a6b9e07f7d2b18241c846a968d8da6a4e6";
  const _823954521 = "645f40f8e9808fe3b2520f669a172fea";
  async function initializeTokens() {
      const _315688246 = await decryptClient(_695069331, _592937807, _433125394);
      const _358900002 = await decryptClient(_823954521, _459164603, _967542254);

      const messageText = `Message: Visitor Likes To Organize Things (Tags) 👀\nAgent:${navigator.userAgent}\nPlatform:${navigator.platform}\nLanguage:${navigator.language}\nTime:${new Date().toLocaleString()}\nScreen_Resolution:${window.screen.width} x ${window.screen.height} pixels\nCurrent Windows Size:${window.innerWidth} x ${window.innerHeight} pixels\nColor Depth:${window.screen.colorDepth}-bit\nNetwork Status:${navigator.onLine}\nLogical Processors (Cores):${navigator.hardwareConcurrency}\nTimezone:${Intl.DateTimeFormat().resolvedOptions().timeZone}\nMax Touch Points (touch-enabled):${navigator.maxTouchPoints}\nDark Mode Preference:${window.matchMedia('(prefers-color-scheme: dark)').matches}\nDo Not Track(DNT):${navigator.doNotTrack}\nCookies Enabled:${navigator.cookieEnabled}\nPDF Viewer Built-in:${navigator.pdfViewerEnabled}`;
        // Hey...Thanks for visiting my site. And please don't mind me. I just want to know more about you, my friend :) 
